<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resource Request Form</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 2rem; }
        .container { max-width: 800px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .user-info { background: #e9ecef; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; font-weight: bold; }
        input, select { width: 100%; padding: 0.5rem; box-sizing: border-box; }
        button { padding: 0.7rem 1.5rem; background-color: #007bff; color: white; border: none; cursor: pointer; }
        button:hover { background-color: #0056b3; }
        .request-list { margin-top: 2rem; border-top: 1px solid #ccc; padding-top: 1rem; }
        .request-item { background: #f9f9f9; padding: 1rem; margin-bottom: 0.5rem; border: 1px solid #ddd; display: flex; justify-content: space-between; align-items: center; }
        .request-details { flex-grow: 1; }
        .request-actions { display: flex; gap: 0.5rem; }
        .btn-edit { background-color: #28a745; padding: 0.4rem 0.8rem; text-decoration: none; color: white; font-size: 0.9rem; border-radius: 3px; }
        .btn-delete { background-color: #dc3545; padding: 0.4rem 0.8rem; color: white; border: none; cursor: pointer; font-size: 0.9rem; border-radius: 3px; }
        .logout { color: #dc3545; text-decoration: none; margin-left: 1rem; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Create Resource Request</h1>
            <div class="user-info">
                Logged in as <strong><%= user.username %></strong> (Group: <%= user.group %>)
                <a href="/logout" class="logout">Logout</a>
            </div>
        </div>
        
        <form action="/requests" method="POST">
            <div class="form-group">
                <label for="vcpu">vCPU Amount</label>
                <select name="vcpu" id="vcpu" required>
                    <% for(let i=1; i<=32; i++) { %>
                        <option value="<%= i %>"><%= i %> vCPU</option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="memory">Memory Amount (GB)</label>
                <select name="memory" id="memory" required>
                    <% for(let i=1; i<=64; i++) { %>
                        <option value="<%= i %>"><%= i %> GB</option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="storage">Storage Size (GB)</label>
                <input type="number" name="storage" id="storage" min="1" max="500" required>
                <small>Between 1 and 500 GB</small>
            </div>

            <button type="submit">Submit Request</button>
        </form>

        <div class="request-list">
            <h2>Recent Requests</h2>
            <% if (requests && requests.length > 0) { %>
                <% requests.forEach(req => { %>
                    <div class="request-item">
                        <div class="request-details">
                            <strong><%= req.requester %></strong> (Group: <%= req.group || 'N/A' %>) requested:
                            <%= req.vcpu %> vCPU, <%= req.memory %> GB RAM, <%= req.storage %> GB Storage
                            <br>
                            <small style="color: #666;">On <%= new Date(req.createdAt).toLocaleString() %></small>
                        </div>
                        <div class="request-actions">
                            <a href="/requests/<%= req._id %>/edit" class="btn-edit">Edit</a>
                            <form action="/requests/<%= req._id %>/delete" method="POST" style="display:inline;">
                                <button type="submit" class="btn-delete" onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No requests yet.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
