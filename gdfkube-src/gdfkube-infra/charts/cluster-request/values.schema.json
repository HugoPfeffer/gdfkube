{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["meta", "system"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["requestId", "formId", "org"],
      "properties": {
        "requestId": { "type": "string" },
        "formId": { "type": "string" },
        "org": { "type": "string" },
        "email": { "type": "string" },
        "submittedAt": { "type": "string" },
        "correlationId": { "type": "string" }
      }
    },
    "vars": {
      "type": "object",
      "properties": {
        "clusterName": { "type": "string" },
        "nodeCount": { "type": "integer" },
        "environment": { "type": "string" }
      }
    },
    "system": {
      "type": "object",
      "required": ["baseDomain", "releaseImage", "naming", "labels"],
      "properties": {
        "baseDomain": { "type": "string" },
        "releaseImage": { "type": "string" },
        "giteaExternalUrl": { "type": "string" },
        "giteaOwner": { "type": "string" },
        "naming": {
          "type": "object",
          "required": ["hostedClusterName", "namespace", "appProject", "clusterSet"],
          "properties": {
            "hostedClusterName": { "type": "string" },
            "namespace": { "type": "string" },
            "appProject": { "type": "string" },
            "clusterSet": { "type": "string" }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
